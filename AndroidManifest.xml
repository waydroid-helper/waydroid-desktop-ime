<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.waydroid.helper.desktopime" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33"/>
    <application android:label="@string/app_name" android:allowBackup="false">
        <service android:name=".HostIme" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>
        <provider android:name=".BridgeProvider" android:authorities="org.waydroid.helper.desktopime"
            android:exported="true" android:permission="android.permission.DUMP"/>
    </application>
</manifest>
